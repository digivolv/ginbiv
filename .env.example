# ─── Reddit API ────────────────────────────────────────────────────────────────
# Obtain from https://www.reddit.com/prefs/apps — create a "script" app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# Format: AppName/Version by YourRedditUsername
REDDIT_USER_AGENT=MaraRedditAgent/0.1 by YOUR_REDDIT_USERNAME

# ─── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# gpt-4o-mini is recommended for cost; use gpt-4o for higher quality
LLM_MODEL=gpt-4o-mini
# Optional: override the base URL for OpenAI-compatible providers (e.g. Ollama)
# LLM_BASE_URL=http://localhost:11434/v1

# ─── Mara Channel ──────────────────────────────────────────────────────────────
# Full YouTube URL for the sleep affirmations video to soft-mention
MARA_YOUTUBE_URL=https://www.youtube.com/watch?v=YOUR_VIDEO_ID

# ─── Autonomy ──────────────────────────────────────────────────────────────────
# Options: review_only | support_only_autopilot | full_autopilot (dangerous — see README)
AUTONOMY_MODE=review_only
# Set to true ONLY if you understand the promo risks — see README
ALLOW_AUTONOMOUS_PROMO=false
# Hard daily ceiling on autonomous posts across all subreddits
MAX_AUTONOMOUS_REPLIES_PER_DAY=10
# Hard daily ceiling per individual subreddit
MAX_AUTONOMOUS_REPLIES_PER_SUBREDDIT_PER_DAY=3
# Enforce a cooldown between any two autonomous posts (minutes)
MIN_MINUTES_BETWEEN_REPLIES=20
# Skip threads posted fewer than this many minutes ago (avoid brigading)
MIN_THREAD_AGE_MINUTES=10
# Maximum age of Reddit content to consider (hours)
MAX_CONTENT_AGE_HOURS=72

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite path (relative to project root)
DATABASE_URL=file:./dev.db
